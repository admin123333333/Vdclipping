# ===== copy to .env and edit =====
# your domain (A record -> server IP)
DOMAIN=clips.example.com

# Groq key the SITE uses when a visitor does not bring their own (https://console.groq.com)
GROQ_API_KEY=

# Contact shown on /legal
CLIPFORGE_CONTACT=you@example.com

# --- Safety defaults for a public site ---
# YouTube links on a public server = YouTube ToS risk + datacenter IPs get blocked. Safer: upload-only (0).
CLIPFORGE_ALLOW_URL=0
CLIPFORGE_MAX_UPLOAD_MB=500
CLIPFORGE_MAX_MINUTES=45
CLIPFORGE_MAX_CLIPS=6
# videos per visitor IP per hour
CLIPFORGE_RATE_PER_HOUR=3
# videos processed at the same time (raise with more CPU cores)
CLIPFORGE_MAX_JOBS=1
CLIPFORGE_MAX_QUEUE=8
# results auto-deleted after this
CLIPFORGE_TTL_HOURS=6
CLIPFORGE_MIN_FREE_GB=3

# --- Speed / look ---
# 1080 looks better but renders ~2x slower on CPU
CLIPFORGE_RES=720
CLIPFORGE_PRESET=veryfast
CLIPFORGE_CHANNEL=@yourchannel
# CLIPFORGE_COOKIES=/run/cookies.txt
# CLIPFORGE_PROXY=http://user:pass@host:port
